APP_PORT=8000
APP_HOST=localhost
LOG_LEVEL=critical
RELOAD=True
DEBUG=True
SENTRY_DSN=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sfmshop
DB_USER=postgres
DB_PASSWORD=password

DB_REPLICA_HOST=localhost
DB_REPLICA_PORT=5432
DB_REPLICA_NAME=sfmshop
DB_REPLICA_USER=postgres
DB_REPLICA_PASSWORD=password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_MAX_RETRIES=3
RABBITMQ_BASE_DELAY=0.5
RABBITMQ_BACKOFF_MULTIPLIER=2

MONGO_URL=mongodb://localhost:27017

ALGORITHM=HS256
JWT_SECRET=dev-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:3000","https://sfmshop.example.ru"]
RATE_LIMIT_LOGIN=5/minute

EXCHANGE_API_URL=https://api.exchangerate-api.com/v4/latest
EXCHANGE_API_URLS=["https://api.exchangerate-api.com/v4/latest","https://api.currencyapi.com/v3/latest","https://api.fixer.io/latest"]
EXCHANGE_TIMEOUT=5
EXCHANGE_MAX_RETRIES=3
EXCHANGE_BACKOFF_BASE=2
